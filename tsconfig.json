{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Preserve",             
    "moduleResolution": "bundler",    
    "rootDir": "./src",
    "outDir": "./dist",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "types": ["node"]
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules"]
}